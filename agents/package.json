{
  "name": "@policysynth/agents",
  "version": "1.3.204",
  "author": "Robert Bjarnason, Citizens Foundation",
  "repository": {
    "type": "git",
    "url": "https://github.com/CitizensFoundation/policy-synth/tree/main/agents"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "c8": "^12.0.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "ts-out/**/*",
    "src/*.d.ts"
  ],
  "scripts": {
    "prepublishOnly": "npm pack && node repack",
    "publish": "npm pack && node repack && node publish.js https://registry.npmjs.org/",
    "publish_local": "npm pack && node repack && node publish.js http://localhost:4873",
    "test": "npm run test:unit",
    "test:build": "tsc --project ./tsconfig.test.json",
    "test:unit": "npm run test:build && node --test ts-out-test/tests/aiModels/*.test.js ts-out-test/tests/base/*.test.js ts-out-test/tests/connectors/*.test.js ts-out-test/tests/dbModels/*.test.js ts-out-test/tests/operations/*.test.js ts-out-test/tests/tools/*.test.js ts-out-test/tests/validations/*.test.js",
    "test:coverage": "npm run test:build && c8 --config .c8rc.json node --test ts-out-test/tests/aiModels/*.test.js ts-out-test/tests/base/*.test.js ts-out-test/tests/connectors/*.test.js ts-out-test/tests/dbModels/*.test.js ts-out-test/tests/operations/*.test.js ts-out-test/tests/tools/*.test.js ts-out-test/tests/validations/*.test.js",
    "createWeaviateRagDocument": "npm run build;cp -R src/rag/vectorstore/schemas ts-out/vectorstore/;node ts-out/rag/vectorstore/tools/createRagDocument.js",
    "createWeaviateRagChunk": "npm run build;cp -R src/rag/vectorstore/schemas ts-out/vectorstore/;node ts-out/rag/vectorstore/tools/createRagChunk.js",
    "destroyWeaviateRagChunk": "node ts-out/rag/vectorstore/tools/destroyRagChunk.js",
    "destroyWeaviateRagDocument": "node ts-out/rag/vectorstore/tools/destroyRagDocument.js",
    "build": "tsc --project ./ --outDir ./ts-out",
    "start": "node --watch --watch-preserve-output ts-out/queue.js",
    "watch-start": "tsc --project ./ --outDir ./ts-out -w & node ts-out/queue.js"
  },
  "cacheDirectories": [
    "node_modules"
  ],
  "type": "module",
  "dependencies": {
    "@airbrake/node": "^2.1.9",
    "@anthropic-ai/bedrock-sdk": "^1.0.0",
    "@anthropic-ai/sdk": "^1.1.0",
    "@anthropic-ai/vertex-sdk": "^1.0.0",
    "@azure/identity": "^4.14.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "^2.31.0",
    "@google/generative-ai": "^0.24.1",
    "@mendable/firecrawl-js": "^4.51.0",
    "axios": "1.20.0",
    "bullmq": "^6.4.0",
    "chalk": "^6.0.1",
    "colors": "^1.4.0",
    "discord.js": "^14.27.0",
    "form-data": "^4.0.6",
    "glob": "^13.0.6",
    "google-auth-library": "^11.3.1",
    "googleapis": "^188.0.0",
    "html-to-text": "^10.0.1",
    "ioredis": "6.0.0",
    "jsonrepair": "^3.15.0",
    "lodash": "^4.18.1",
    "mammoth": "^1.13.0",
    "node-fetch": "^3.3.2",
    "openai": "^7.43.0",
    "p-limit": "^7.3.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "puppeteer": "^25.16.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qs": "^6.16.1",
    "sequelize": "^6.37.8",
    "tar": "^7.5.22",
    "tiktoken": "^1.0.22",
    "tldts": "^7.4.19",
    "weaviate-ts-client": "^2.2.0",
    "winston": "^3.19.0",
    "ws": "^8.22.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "openai": {
      "google-auth-library": "$google-auth-library"
    },
    "sequelize": {
      "uuid": "11.1.1"
    },
    "weaviate-ts-client": {
      "uuid": "11.1.1"
    }
  }
}
